generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            Role      @default(USER)
  adminSubRole    AdminSubRole?
  isResearcher    Boolean   @default(false)
  // Per-user permission adjustments on top of the role's default grants (see
  // RolePermission): { grant: string[], revoke: string[] }. Lets an admin
  // compose a custom permission set for one person without inventing a new
  // Role enum value for every edge case (e.g. "this one PROFESSIONAL also
  // triages support tickets").
  permissionOverrides Json?
  firstName       String
  lastName        String
  avatarUrl       String?
  country         String
  language        String    @default("fr")
  isEmailVerified Boolean   @default(false)
  kycStatus       KycStatus @default(PENDING)
  kycDocuments    Json?
  walletBalance   Decimal   @default(0) @db.Decimal(10, 2)
  reputationScore Int       @default(0)
  referralCode    String    @unique
  referredById    String?
  fcmToken        String?
  isActive        Boolean   @default(true)
  isBanned        Boolean   @default(false)
  banReason       String?
  banExpiresAt    DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  referredBy              User?                    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals               User[]                   @relation("UserReferrals")
  professionalProfile     ProfessionalProfile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  products                Product[]                @relation("SellerProducts")
  purchases               Order[]                  @relation("BuyerOrders")
  sales                   Order[]                  @relation("SellerOrders")
  approvedRefunds         Order[]                  @relation("RefundApprover")
  cartItems               CartItem[]
  coupons                 Coupon[]
  reviews                 Review[]
  bids                    Bid[]
  plantMonographs         PlantMonograph[]
  articles                Article[]
  questions               Question[]
  answers                 Answer[]
  forumComments           ForumComment[]
  votes                   Vote[]
  reports                 Report[]
  events                  Event[]
  eventRegistrations      EventRegistration[]
  formations              Formation[]
  mlmNode                 MLMNode?
  commissions             Commission[]
  subscription            Subscription?
  walletTransactions      WalletTransaction[]
  notifications           Notification[]
  savedSearches           SavedSearch[]
  favorites               Favorite[]
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  tickets                 Ticket[]
  ticketMessages          TicketMessage[]
  siteConfigUpdates       SiteConfig[]
  pageUpdates             Page[]
  auditLogs               AuditLog[]                @relation("AuditActor")
  bookingsAsClient        Booking[]                 @relation("ClientBookings")
  bookingsAsProfessional  Booking[]                 @relation("ProfessionalBookings")
  quoteRequestsAsBuyer    QuoteRequest[]            @relation("QuoteBuyer")
  quoteRequestsAsSeller   QuoteRequest[]            @relation("QuoteSeller")
  affiliateLink           AffiliateLink?

  @@index([email])
  @@index([role])
  @@index([adminSubRole])
  @@index([isResearcher])
  @@index([kycStatus])
  @@index([country])
  @@index([createdAt(sort: Desc)])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProfessionalProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  displayName            String
  specialty              String[]
  biography              String    @db.Text
  initiationPath         String?   @db.Text
  therapeuticSuccessRate Float?
  innovations            String?   @db.Text
  communityImpact        String?   @db.Text
  philosophy             String?   @db.Text
  location               String
  latitude               Float?
  longitude              Float?
  isVerified             Boolean   @default(false)
  verifiedAt             DateTime?
  verificationDocs       Json?
  photos                 String[]
  socialLinks            Json?
  averageRating          Float     @default(0)
  totalReviews           Int       @default(0)
  isPortraitOfWeek       Boolean   @default(false)
  portraitStartDate      DateTime?
  portraitEndDate        DateTime?
  serviceBookingEnabled  Boolean   @default(false)
  availabilitySchedule   Json?
  defaultCommissionRate  Float?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVerified])
  @@index([isPortraitOfWeek])
  @@index([latitude, longitude])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id              String        @id @default(cuid())
  clientId        String
  professionalId  String
  productId       String?
  serviceName     String
  scheduledAt     DateTime
  durationMinutes Int           @default(30)
  status          BookingStatus @default(PENDING)
  notes           String?       @db.Text
  cancelReason    String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client       User     @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  professional User     @relation("ProfessionalBookings", fields: [professionalId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([professionalId])
  @@index([scheduledAt])
  @@index([status])
}

enum QuoteStatus {
  PENDING
  PROPOSED
  ACCEPTED
  DECLINED
}

model QuoteRequest {
  id            String      @id @default(cuid())
  productId     String
  buyerId       String
  sellerId      String
  status        QuoteStatus @default(PENDING)
  proposedPrice Decimal?    @db.Decimal(10, 2)
  message       String?     @db.Text
  responseNote  String?     @db.Text
  orderId       String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   User    @relation("QuoteBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("QuoteSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Product {
  id             String      @id @default(cuid())
  sellerId       String
  title          String
  slug           String      @unique
  description    String      @db.Text
  price          Decimal     @db.Decimal(10, 2)
  category       MedCategory
  type           ProductType
  images         String[]
  stock          Int         @default(0)
  isActive       Boolean     @default(true)
  isApproved     Boolean     @default(false)
  isFeatured     Boolean     @default(false)
  featuredUntil  DateTime?
  isUrgent       Boolean     @default(false)
  urgentUntil    DateTime?
  isQuoteOnly    Boolean     @default(false)
  auctionEnabled Boolean     @default(false)
  auctionEndDate DateTime?
  currentBid     Decimal?    @db.Decimal(10, 2)
  commissionRate Float?
  downloadLimit  Int?
  fileUrl        String?
  watermarked    Boolean     @default(false)
  viewCount      Int         @default(0)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  seller        User           @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  orders        Order[]
  cartItems     CartItem[]
  bids          Bid[]
  bookings      Booking[]
  quoteRequests QuoteRequest[]

  @@index([sellerId])
  @@index([slug])
  @@index([category])
  @@index([type])
  @@index([isActive, isApproved])
  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
}

model Order {
  id                   String        @id @default(cuid())
  buyerId              String
  sellerId             String
  productId            String
  quantity             Int
  unitPrice            Decimal       @db.Decimal(10, 2)
  totalAmount          Decimal       @db.Decimal(10, 2)
  commissionAmount     Decimal       @db.Decimal(10, 2)
  discountAmount       Decimal       @default(0) @db.Decimal(10, 2)
  status               OrderStatus   @default(PENDING)
  paymentMethod        String?
  monerooTransactionId String?
  escrowStatus         EscrowStatus  @default(HELD)
  deliveryConfirmedAt  DateTime?
  disputeReason        String?
  refundStatus         RefundStatus?
  refundApprovedById   String?
  sellerRefundNote     String?
  sellerAcknowledgedAt DateTime?
  affiliateLinkId      String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  buyer          User           @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller         User           @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  refundApprover User?          @relation("RefundApprover", fields: [refundApprovedById], references: [id], onDelete: SetNull)
  affiliateLink  AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  commissions    Commission[]
  quoteRequest   QuoteRequest?

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@index([escrowStatus])
  @@index([affiliateLinkId])
  @@index([createdAt(sort: Desc)])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discount     Float
  isPercentage Boolean   @default(true)
  maxUses      Int?
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  sellerId     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  seller User? @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([code])
  @@index([isActive])
}

model Review {
  id           String       @id @default(cuid())
  authorId     String
  targetId     String
  targetType   ReviewTarget
  rating       Int
  comment      String?      @db.Text
  isHidden     Boolean      @default(false)
  hiddenReason String?
  createdAt    DateTime     @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, targetId, targetType])
  @@index([targetId, targetType])
  @@index([createdAt(sort: Desc)])
}

model Bid {
  id        String   @id @default(cuid())
  productId String
  bidderId  String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([bidderId])
  @@index([createdAt(sort: Desc)])
}

model PlantMonograph {
  id                     String   @id @default(cuid())
  slug                   String?  @unique
  scientificName         String   @unique
  vernacularNames        Json
  family                 String?
  origin                 String?
  region                 String?
  therapeuticCategory    String?
  indications            String[]
  summary                String?  @db.Text
  medicinalProperties    Json?
  preparations           String[]
  precautions            String[]
  references             String[]
  botanicalDescription   String   @db.Text
  activeCompounds        String   @db.Text
  therapeuticIndications String   @db.Text
  dosage                 String   @db.Text
  contraindications      String   @db.Text
  clinicalStudies        String?  @db.Text
  drugInteractions       String?  @db.Text
  preparationMethods     String   @db.Text
  illustration           String?
  fieldPhotos            String[]
  createdById            String
  isPublished            Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([isPublished])
  @@index([createdAt(sort: Desc)])
}

model Article {
  id          String       @id @default(cuid())
  authorId    String
  space       ArticleSpace
  title       String
  slug        String       @unique
  content     String       @db.Text
  coverImage  String?
  category    String?
  tags        String[]
  // Structured recipe fields, only populated when space = RECETTES_SANTE:
  // { ingredients: string[], steps: string[], plants: {name,slug}[], difficulty, prepTime, type }
  recipeData  Json?
  isPublished Boolean      @default(false)
  isApproved  Boolean      @default(false)
  publishedAt DateTime?
  rejectedAt  DateTime?
  views       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([slug])
  @@index([space])
  @@index([category])
  @@index([isPublished, isApproved])
  @@index([createdAt(sort: Desc)])
}

model Question {
  id               String   @id @default(cuid())
  authorId         String
  title            String
  content          String   @db.Text
  category         String
  categoryId       String?
  customFields     Json?
  tags             String[]
  isClosed         Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  isHidden         Boolean  @default(false)
  acceptedAnswerId String?  @unique
  voteCount        Int      @default(0)
  viewCount        Int      @default(0)
  attachments      String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author         User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryRef    ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  answers        Answer[]      @relation("QuestionAnswers")
  acceptedAnswer Answer?       @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([category])
  @@index([categoryId])
  @@index([isClosed])
  @@index([isFeatured])
  @@index([createdAt(sort: Desc)])
}

model ForumCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  parent    ForumCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ForumCategory[] @relation("CategoryTree")
  questions Question[]

  @@index([parentId])
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  authorId    String
  content     String   @db.Text
  voteCount   Int      @default(0)
  isAccepted  Boolean  @default(false)
  isHidden    Boolean  @default(false)
  attachments String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question    Question  @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  acceptedFor Question? @relation("AcceptedAnswer")

  @@index([questionId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
}

model ForumComment {
  id         String   @id @default(cuid())
  authorId   String
  targetId   String
  targetType String
  content    String   @db.Text
  voteCount  Int      @default(0)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([targetId, targetType])
  @@index([createdAt(sort: Desc)])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetId   String
  targetType String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType])
  @@index([userId])
  @@index([targetId, targetType])
}

model Vote {
  id         String   @id @default(cuid())
  userId     String
  targetId   String
  targetType String
  value      Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, targetType])
  @@index([targetId, targetType])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  targetId   String
  targetType String
  reason     String
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([targetId, targetType])
  @@index([status])
}

model Event {
  id           String    @id @default(cuid())
  title        String
  description  String    @db.Text
  type         EventType
  startDate    DateTime
  endDate      DateTime
  location     String?
  isOnline     Boolean   @default(false)
  meetingUrl   String?
  maxAttendees Int?
  coverImage   String?
  createdById  String
  isPublished  Boolean   @default(false)
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  registrations EventRegistration[]

  @@index([createdById])
  @@index([type])
  @@index([startDate])
  @@index([isPublished])
  @@index([createdAt(sort: Desc)])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  userId       String
  registeredAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Formation {
  id             String            @id @default(cuid())
  slug           String?           @unique
  title          String
  description    String?           @db.Text
  type           FormationType
  fileUrl        String
  coverImage     String?
  category       String
  tags           String[]
  level          String?
  duration       String?
  price          Decimal           @default(0) @db.Decimal(10, 2)
  currency       String            @default("XOF")
  prerequisites  String[]
  learnings      String[]
  instructorBio  String?           @db.Text
  createdById    String
  isPublished    Boolean           @default(false)
  rejectedAt     DateTime?
  downloadCount  Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  modules   FormationModule[]

  @@index([createdById])
  @@index([type])
  @@index([category])
  @@index([isPublished])
  @@index([createdAt(sort: Desc)])
}

model FormationModule {
  id          String   @id @default(cuid())
  formationId String
  title       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  formation Formation         @relation(fields: [formationId], references: [id], onDelete: Cascade)
  lessons   FormationLesson[]

  @@index([formationId])
}

model FormationLesson {
  id         String   @id @default(cuid())
  moduleId   String
  title      String
  duration   String?
  type       String   @default("video")
  order      Int      @default(0)
  contentUrl String?
  createdAt  DateTime @default(now())

  module FormationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model MLMNode {
  id                  String   @id @default(cuid())
  userId              String   @unique
  parentId            String?
  level               Int      @default(0)
  affiliateCode       String   @unique
  affiliateLinkClicks Int      @default(0)
  totalDownlineCount  Int      @default(0)
  totalEarnings       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   MLMNode?  @relation("MLMTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MLMNode[] @relation("MLMTree")

  @@index([parentId])
  @@index([affiliateCode])
}

// A single-tier "share a link, earn on the sale" program — deliberately
// separate from MLMNode's recruitment/downline tree, per the spec treating
// affiliation and network marketing as two distinct programs.
model AffiliateLink {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([code])
}

model Commission {
  id            String           @id @default(cuid())
  userId        String
  sourceOrderId String
  amount        Decimal          @db.Decimal(10, 2)
  type          CommissionType
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceOrder Order @relation(fields: [sourceOrderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceOrderId])
  @@index([type])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model Subscription {
  id           String           @id @default(cuid())
  userId       String           @unique
  plan         SubscriptionPlan @default(FREE)
  price        Decimal          @db.Decimal(10, 2)
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean          @default(true)
  maxListings  Int              @default(5)
  maxDownloads Int              @default(10)
  autoRenew    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([isActive])
  @@index([endDate])
}

model WalletTransaction {
  id            String          @id @default(cuid())
  userId        String
  amount        Decimal         @db.Decimal(10, 2)
  type          TransactionType
  reference     String          @unique
  description   String?
  balanceBefore Decimal         @db.Decimal(10, 2)
  balanceAfter  Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt(sort: Desc)])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  summary   String?
  criteria  Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  attachments String[]
  createdAt   DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
  @@index([createdAt(sort: Desc)])
}

model Ticket {
  id        String       @id @default(cuid())
  authorId  String
  subject   String
  category  String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  messages TicketMessage[]

  @@index([authorId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
}

model SiteConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  updatedById String
  updatedAt   DateTime @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([key])
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  contentHtml     String   @db.Text
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([isPublished])
}

model AdSpace {
  id        String   @id @default(cuid())
  name      String
  position  String
  code      String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}

model HomeBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  link      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  language         String    @default("fr")
  unsubscribeToken String    @unique
  isActive         Boolean   @default(true)
  subscribedAt     DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetId   String?
  targetType String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([targetId, targetType])
  @@index([createdAt(sort: Desc)])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  EDITOR
  PROFESSIONAL
  RESEARCHER
  USER
}

// Default permission grants per role — the seed of a user's effective
// permission set, before User.permissionOverrides is applied. Additive on
// top of the Role enum: existing checkRole(...) call sites keep working
// unchanged, and are migrated to checkPermission(...) incrementally.
model RolePermission {
  id         String   @id @default(cuid())
  role       Role
  permission String
  createdAt  DateTime @default(now())

  @@unique([role, permission])
  @@index([role])
}

